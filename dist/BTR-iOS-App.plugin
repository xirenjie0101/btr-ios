#!name = BTR-iOS App 模式（线程撕裂者）
#!desc = 让哔哩哔哩 App（国内版/国际版）取视频时多线程、多 CDN 并发预读，缓解海外看冷门、高码率视频卡顿。出错或不适用时自动原样放行。统计页：Safari 打开 https://www.bilibili.com/__btr_app__/ 。思路来自开源项目 Bilibili-thread-ripper，非官方。若同时装了 BiliUniverse Redirect 等改 B 站 CDN 的插件，请先关掉它们。
#!author = BTR-iOS
#!homepage = https://github.com/xirenjie0101/btr-ios
#!icon = https://raw.githubusercontent.com/xirenjie0101/btr-ios/main/dist/icon.png
#!openUrl = https://www.bilibili.com/__btr_app__/
#!tag = 哔哩哔哩, 视频加速
#!system = iOS, iPadOS
#!date = 2026-09-18
#!version = 1.4.0

[Argument]
conns = select,"32","16","64","8",tag=并发连接数,desc=每一批同时开几条连接。到大陆节点的单条连接很慢（每条几十 KB/s），靠的是数量；快的节点会分到更多、更大的块。发热明显就调到 16
ahead = select,"4MB","2MB","8MB","关闭",tag=预读大小,desc=App 要一小段时，顺便多取多少放进缓存，App 接着要的时候直接给。会按测得的速度自动缩放，这里是上限；关闭则只取 App 要的那一段
cache = select,"16MB","8MB","32MB","关闭",tag=缓存上限,desc=预读的数据最多占多少存储（一批预读最多用掉一半）。播放位置之前的、超过 10 分钟的会自动淘汰；Loon 不稳定就调小
cdn = select,"大陆CDN","海外CDN",tag=CDN 模式,desc=海外看冷门视频选大陆 CDN（配合多线程）；到大陆线路特别差再试海外 CDN
openEnded = select,"分块答复","原样放行",tag=大范围取流请求,desc=分块答复才能加速“一直读到底”的请求；如果开着插件 App 放不了视频，改成原样放行
notify = switch,true,tag=通知,desc=开始加速、保险丝跳闸时发一条通知

[General]
# App 的一部分取流走明文 HTTP 和非标准端口，让它们也经过 HTTP 引擎，脚本才看得到
force-http-engine-hosts = upos-sz-mirror*.bilivideo.com:80, cn-hk-eq-*.bilivideo.com:80, upos-*-mirrorakam.akamaized.net:80, *:4480, *:4483, *:8000, *:8082, *:9102

[Rule]
# MITM 只看得到 TCP 上的请求；不让视频 CDN 走 QUIC，App 会自动退回 HTTPS
AND,((DOMAIN-SUFFIX,bilivideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,bilivideo.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-KEYWORD,mirrorakam),(PROTOCOL,QUIC)),REJECT
# 统计页也一样：Safari 走了 QUIC 的话 Loon 看不到这个请求，会直接打开 B 站的 404 页
AND,((DOMAIN,www.bilibili.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,m.bilibili.com),(PROTOCOL,QUIC)),REJECT
# 视频数据最好直连。如果你的配置会把 B 站 CDN 分流到代理节点，把下面两行开头的 # 去掉：
# DOMAIN-SUFFIX,bilivideo.com,DIRECT
# DOMAIN-SUFFIX,bilivideo.cn,DIRECT

[Script]
http-request ^https?:\/\/[^\/]+\/upgcxcode\/.+\.m4s script-path=https://raw.githubusercontent.com/xirenjie0101/btr-ios/main/dist/btr-app.js, tag=BTR App 模式, timeout=30, argument=[{conns},{ahead},{cache},{cdn},{openEnded},{notify}]
http-request ^https?:\/\/[^\/]+(?::\d+)?\/v1\/resource\/.+\.m4s script-path=https://raw.githubusercontent.com/xirenjie0101/btr-ios/main/dist/btr-app.js, tag=BTR App 模式（其他取流方式，仅统计）, timeout=10, argument=[{conns},{ahead},{cache},{cdn},{openEnded},{notify}]
http-request ^https?:\/\/(?:www|m)\.bilibili\.com\/__btr_app__ script-path=https://raw.githubusercontent.com/xirenjie0101/btr-ios/main/dist/btr-app.js, tag=BTR App 模式统计页, timeout=10, argument=[{conns},{ahead},{cache},{cdn},{openEnded},{notify}]

[MITM]
hostname = upos-*.bilivideo.com, cn-hk-eq-*.bilivideo.com, *.mcdn.bilivideo.cn, upos-*-mirrorakam.akamaized.net, www.bilibili.com
